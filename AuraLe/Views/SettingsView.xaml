<UserControl x:Class="AuraLe.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <!-- ================= 4.3 설정 뷰 (⚙ Settings View: 상단 탭 유지 + 좌측 카테고리 네비 + 우측 스크롤 뷰) ================= -->
    <Border Margin="14,8,14,12" Height="370" CornerRadius="18" Background="#0C0F17" BorderBrush="{Binding ThemeAccentBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <!-- 상단 헤더 & 탭 선택 바 (유지) -->
                <RowDefinition Height="Auto"/>
                <!-- 메인 콘텐츠 영역 -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= [ROW 0] 상단 설정 탭 (유지) ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <!-- 좌측: 설정 뱃지 & 탭 버튼 그룹 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding ThemeAccentBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="CONFIG" FontWeight="Black" FontSize="11" Foreground="#0A0A10"/>
                    </Border>

                    <!-- [📼 카세트 테마 설정 탭] -->
                    <Button Content="📼 카세트 테마 설정" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Cassette" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RetroButtonStyle}">
                                <Setter Property="Padding" Value="10,5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCassetteSettingsTab}" Value="True">
                                        <Setter Property="Background" Value="#252D3E"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="{Binding ThemeAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- [📁 보관함 폴더 설정 탭] -->
                    <Button Content="📁 보관함 폴더 설정" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Download" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RetroButtonStyle}">
                                <Setter Property="Padding" Value="10,5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloadSettingsTab}" Value="True">
                                        <Setter Property="Background" Value="#252D3E"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="{Binding ThemeAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- 우측: 덱으로 복귀 버튼 -->
                <Button Content="◀ 덱으로 복귀" Style="{StaticResource RetroButtonStyle}"
                        Command="{Binding SwitchViewCommand}" CommandParameter="Player"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"/>
            </Grid>

            <!-- ================= [ROW 1] 탭 콘텐츠 본문 ================= -->
            <Grid Grid.Row="1">
                <!-- ================= 탭 1: 카세트 테마 설정 (좌측 항목 버튼들 + 우측 스크롤 패널) ================= -->
                <Grid Visibility="{Binding IsCassetteSettingsTab, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <!-- 좌측: 항목 선택 사이드바 버튼 목록 (폭 125) -->
                        <ColumnDefinition Width="125"/>
                        <!-- 우측: 넓고 여유로운 스크롤 뷰 (폭 *) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- [좌측 사이드바] 각 항목 바로가기 버튼들 -->
                    <Border Grid.Column="0" Background="#0E121B" CornerRadius="10" BorderBrush="#1C2738" BorderThickness="1" Padding="6,8">
                        <StackPanel>
                            <TextBlock Text="SETTING LIST" FontSize="9.5" FontWeight="Bold" Foreground="#556677" Margin="4,2,0,8"/>

                            <Button Content="🖼 배경 설정" Tag="Background" Click="NavButton_Click"
                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="0,0,0,5" Padding="8,4"
                                    HorizontalContentAlignment="Left" FontSize="11"/>

                            <Button Content="⚙ 릴 휠 에셋" Tag="Reel" Click="NavButton_Click"
                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="0,0,0,5" Padding="8,4"
                                    HorizontalContentAlignment="Left" FontSize="11"/>

                            <Button Content="🌈 테마 색상" Tag="Color" Click="NavButton_Click"
                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="0,0,0,5" Padding="8,4"
                                    HorizontalContentAlignment="Left" FontSize="11"/>

                            <Button Content="✨ 기타 / 효과" Tag="Etc" Click="NavButton_Click"
                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="0,0,0,5" Padding="8,4"
                                    HorizontalContentAlignment="Left" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- [우측 메인 패널] 넉넉한 폭의 스크롤 패널 (각 섹션 자유 스크롤) -->
                    <Border Grid.Column="1" Background="#111622" CornerRadius="10" BorderBrush="#1C2738" BorderThickness="1" Margin="8,0,0,0" ClipToBounds="True">
                        <ScrollViewer x:Name="CassetteScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12">
                            <StackPanel>

                                <!-- ================= [섹션 1] 🖼 배경 이미지 & 위치 오프셋 ================= -->
                                <StackPanel x:Name="SectionBackground">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="🖼 카세트 배경 일러스트 설정" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="카세트 테이프 본체 뒤편에 노출될 나만의 일러스트 이미지를 등록합니다." FontSize="10" Foreground="#7A8E9F" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="📂 이미지 파일 선택..." Style="{StaticResource RetroButtonStyle}"
                                                Command="{Binding ChangeBackgroundCommand}" Height="28" Margin="0,0,6,0" FontSize="11"/>
                                        <Button Grid.Column="1" Content="↺ 기본값 리셋" Style="{StaticResource RetroButtonStyle}"
                                                Command="{Binding ResetBackgroundCommand}" Height="28" Padding="10,4" FontSize="11"/>
                                    </Grid>

                                    <!-- 배경 위치 가로 오프셋 슬라이더 -->
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="배경 가로 위치 (좌/우 오프셋):" FontSize="10" Foreground="#8FA3B8"/>
                                        <TextBlock Text="{Binding BackgroundImageOffsetX, StringFormat='{}{0:F0} px'}"
                                                   FontSize="10" Foreground="{Binding ThemeAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Minimum="-200" Maximum="200" SmallChange="5" LargeChange="20"
                                            Value="{Binding BackgroundImageOffsetX, Mode=TwoWay}"
                                            Style="{StaticResource CyanSliderStyle}" Height="18"/>
                                </StackPanel>

                                <!-- 구분선 -->
                                <Border Height="1" Background="#1C2738" Margin="0,14,0,14"/>

                                <!-- ================= [섹션 2] ⚙ 릴 휠 에셋 ================= -->
                                <StackPanel x:Name="SectionReel">
                                    <TextBlock Text="⚙ 카세트 회전 릴 휠 에셋" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock Text="음악 재생 시 카세트 덱 중앙에서 함께 회전하는 릴 휠(기어) PNG 이미지를 변경합니다."
                                               FontSize="10" Foreground="#7A8E9F" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 미니 회전 릴 프리뷰 (44x44) -->
                                        <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Ellipse Fill="#05080E" Width="44" Height="44"/>
                                            <Image Source="{Binding ReelImageSource}" Width="44" Height="44"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Style="{StaticResource RotatingReelStyle}"/>
                                            <Ellipse Width="14" Height="14" Fill="#060A10" Stroke="{Binding ThemeAccentBrush}" StrokeThickness="1.5"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="⚙ 휠 PNG 이미지 변경..." Style="{StaticResource RetroButtonStyle}"
                                                        Command="{Binding ChangeReelImageCommand}" Height="28" Margin="0,0,6,0" FontSize="11"/>
                                                <Button Grid.Column="1" Content="↺ 기본 휠 리셋" Style="{StaticResource RetroButtonStyle}"
                                                        Command="{Binding ResetReelImageCommand}" Height="28" Padding="10,4" FontSize="11"/>
                                            </Grid>
                                            <TextBlock Text="* 1:1 정사각 비율의 투명 배경 PNG 이미지를 권장합니다." FontSize="9.5" Foreground="#556677"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- 구분선 -->
                                <Border Height="1" Background="#1C2738" Margin="0,14,0,14"/>

                                <!-- ================= [섹션 3] 🌈 테마 색상 & 그라데이션 ================= -->
                                <StackPanel x:Name="SectionColor">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="🌈 테마 색상 &amp; 그라데이션" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <!-- 윈도우 기본 색상창 직접 열기 버튼 -->
                                        <Button Content="🎨 Windows 색상표 직접 열기" Command="{Binding PickCustomSolidColorCommand}"
                                                ToolTip="Windows 기본 색상 대화상자에서 원하는 색상을 자유롭게 선택합니다."
                                                Style="{StaticResource RetroButtonStyle}" HorizontalAlignment="Right" Padding="8,4" FontSize="10.5"/>
                                    </Grid>

                                    <!-- 3단 서브 카테고리 탭 (넓은 영역에서 시원하게 배치) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="일반 색상" Command="{Binding SwitchColorCategoryCommand}" CommandParameter="Normal" Margin="0,0,4,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RetroButtonStyle}">
                                                    <Setter Property="Padding" Value="10,4"/>
                                                    <Setter Property="FontSize" Value="10.5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNormalColorCategory}" Value="True">
                                                            <Setter Property="Background" Value="#252D3E"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="{Binding ThemeAccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="네온 색상" Command="{Binding SwitchColorCategoryCommand}" CommandParameter="Neon" Margin="0,0,4,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RetroButtonStyle}">
                                                    <Setter Property="Padding" Value="10,4"/>
                                                    <Setter Property="FontSize" Value="10.5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNeonColorCategory}" Value="True">
                                                            <Setter Property="Background" Value="#252D3E"/>
                                                            <Setter Property="Foreground" Value="#00F0FF"/>
                                                            <Setter Property="BorderBrush" Value="{Binding ThemeAccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="그라데이션" Command="{Binding SwitchColorCategoryCommand}" CommandParameter="Gradient">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RetroButtonStyle}">
                                                    <Setter Property="Padding" Value="10,4"/>
                                                    <Setter Property="FontSize" Value="10.5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGradientColorCategory}" Value="True">
                                                            <Setter Property="Background" Value="#252D3E"/>
                                                            <Setter Property="Foreground" Value="#FFE600"/>
                                                            <Setter Property="BorderBrush" Value="{Binding ThemeAccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <!-- 1. 일반 색상 팔레트 (3열 배치) -->
                                    <StackPanel Visibility="{Binding IsNormalColorCategory, Converter={StaticResource BoolToVis}}">
                                        <UniformGrid Columns="3" Margin="0,0,0,8">
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="골드|#C5A059"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#C5A059" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="골드" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="화이트|#F0F4F8"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#F0F4F8" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="화이트" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="실버|#9EAFC2"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#9EAFC2" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="실버" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="블루|#3B82F6"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#3B82F6" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="블루" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="그린|#10B981"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#10B981" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="그린" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="레드|#E11D48"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#E11D48" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="레드" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>

                                        <Button Content="⚡ 현재 색상을 네온(채도 100%) 톤으로 변환"
                                                Command="{Binding ConvertCurrentColorToNeonCommand}"
                                                Style="{StaticResource RetroButtonStyle}" Height="28" FontSize="11" Margin="2,0,2,0"/>
                                    </StackPanel>

                                    <!-- 2. 네온 색상 팔레트 (3열 배치) -->
                                    <StackPanel Visibility="{Binding IsNeonColorCategory, Converter={StaticResource BoolToVis}}">
                                        <UniformGrid Columns="3" Margin="0,0,0,8">
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="네온 사이언|#00F0FF"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#00F0FF" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="네온 사이언" FontSize="11" Foreground="#00F0FF" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="네온 옐로우|#FFE600"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#FFE600" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="네온 옐로우" FontSize="11" Foreground="#FFE600" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="네온 핑크|#FF007F"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#FF007F" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="네온 핑크" FontSize="11" Foreground="#FF007F" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="네온 그린|#00E676"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#00E676" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="네온 그린" FontSize="11" Foreground="#00E676" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="네온 퍼플|#BD00FF"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#BD00FF" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="네온 퍼플" FontSize="11" Foreground="#BD00FF" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySolidColorCommand}" CommandParameter="네온 아쿠아|#00E5FF"
                                                    Style="{StaticResource RetroButtonStyle}" Height="34" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#00E5FF" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="네온 아쿠아" FontSize="11" Foreground="#00E5FF" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- 3. 그라데이션 팔레트 & 커스텀 빌더 -->
                                    <StackPanel Visibility="{Binding IsGradientColorCategory, Converter={StaticResource BoolToVis}}">
                                        <!-- 나만의 그라데이션 만들기 카드 -->
                                        <Border Background="#0E121B" CornerRadius="8" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="🎨 나만의 그라데이션 (시작색 ➔ 끝색 조합):" FontSize="10.5" Foreground="#8FA3B8" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Command="{Binding PickGradientStartColorCommand}"
                                                            Style="{StaticResource RetroButtonStyle}" Height="30" Padding="6,2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="시작색: " FontSize="10" Foreground="#888899"/>
                                                            <TextBlock Text="{Binding CurrentThemeColor1}" FontSize="10" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <TextBlock Grid.Column="1" Text="➔" FontSize="12" Foreground="#FFE600" VerticalAlignment="Center" Margin="8,0"/>

                                                    <Button Grid.Column="2" Command="{Binding PickGradientEndColorCommand}"
                                                            Style="{StaticResource RetroButtonStyle}" Height="30" Padding="6,2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="끝색: " FontSize="10" Foreground="#888899"/>
                                                            <TextBlock Text="{Binding CurrentThemeColor2}" FontSize="10" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 프리셋 6종 (3열 배치) -->
                                        <UniformGrid Columns="3" Margin="0,0,0,0">
                                            <Button Command="{Binding ApplyGradientColorCommand}" CommandParameter="사이언 ➔ 골드|#00D2FF|#D4AF37"
                                                    Style="{StaticResource RetroButtonStyle}" Height="32" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="12" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#00D2FF" Offset="0.0"/>
                                                                <GradientStop Color="#D4AF37" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="사이언 ➔ 골드" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplyGradientColorCommand}" CommandParameter="사이언 ➔ 옐로우|#00F0FF|#FFE600"
                                                    Style="{StaticResource RetroButtonStyle}" Height="32" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="12" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#00F0FF" Offset="0.0"/>
                                                                <GradientStop Color="#FFE600" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="사이언 ➔ 옐로우" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplyGradientColorCommand}" CommandParameter="핑크 ➔ 퍼플|#FF007F|#8A2BE2"
                                                    Style="{StaticResource RetroButtonStyle}" Height="32" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="12" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FF007F" Offset="0.0"/>
                                                                <GradientStop Color="#8A2BE2" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="핑크 ➔ 퍼플" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplyGradientColorCommand}" CommandParameter="그린 ➔ 블루|#00E676|#00B4D8"
                                                    Style="{StaticResource RetroButtonStyle}" Height="32" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="12" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#00E676" Offset="0.0"/>
                                                                <GradientStop Color="#00B4D8" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="그린 ➔ 블루" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplyGradientColorCommand}" CommandParameter="레드 ➔ 오렌지|#FF3B30|#FF9500"
                                                    Style="{StaticResource RetroButtonStyle}" Height="32" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="12" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FF3B30" Offset="0.0"/>
                                                                <GradientStop Color="#FF9500" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="레드 ➔ 오렌지" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplyGradientColorCommand}" CommandParameter="퍼플 ➔ 핑크|#7928CA|#FF0080"
                                                    Style="{StaticResource RetroButtonStyle}" Height="32" Margin="2" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="12" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#7928CA" Offset="0.0"/>
                                                                <GradientStop Color="#FF0080" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="퍼플 ➔ 핑크" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 구분선 -->
                                <Border Height="1" Background="#1C2738" Margin="0,14,0,14"/>

                                <!-- ================= [섹션 4] ✨ 창 투명도 & 네온 발광 효과 ================= -->
                                <StackPanel x:Name="SectionEtc">
                                    <TextBlock Text="✨ 창 투명도 &amp; 시각 효과" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock Text="전체 창의 유리 투명도와 테두리 발광(Glow) 효과를 설정합니다." FontSize="10" Foreground="#7A8E9F" Margin="0,0,0,8"/>

                                    <!-- 투명도 조절 -->
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="창 전체 투명도 (Glass Opacity):" FontSize="10" Foreground="#8FA3B8"/>
                                        <TextBlock Text="{Binding WindowOpacity, StringFormat='{}{0:P0}'}"
                                                   FontSize="10" Foreground="{Binding ThemeAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Minimum="0.2" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                            Value="{Binding WindowOpacity, Mode=TwoWay}"
                                            Style="{StaticResource CyanSliderStyle}" Height="18" Margin="0,0,0,10"/>

                                    <!-- 네온 발광 블러 효과 체크박스 -->
                                    <Border Background="#0E121B" CornerRadius="8" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8">
                                        <CheckBox IsChecked="{Binding IsNeonGlow, Mode=TwoWay}"
                                                  Foreground="#00F0FF" FontSize="11" FontWeight="SemiBold"
                                                  Content="⚡ 네온 발광(Glow) 블러 외곽선 켜기 (카세트 주변 발광 효과)"/>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ================= 탭 2: 보관함 폴더 설정 (상단 탭으로 전환) ================= -->
                <Grid Visibility="{Binding IsDownloadSettingsTab, Converter={StaticResource BoolToVis}}">
                    <Border Background="#111622" CornerRadius="10" BorderBrush="#1C2738" BorderThickness="1" Padding="16,14">
                        <StackPanel>
                            <!-- 1. 최종 MP3 보관 폴더 -->
                            <TextBlock Text="🎵 MP3 보관 및 재생 폴더 (Music Library Storage)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="플레이리스트에 스캔되어 등록되고 재생할 MP3 음원 파일들이 보관되는 기본 디렉토리입니다."
                                       FontSize="10" Foreground="#7A8E9F" Margin="0,0,0,8"/>

                            <Border Background="#0A0E18" CornerRadius="6" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding CurrentDownloadPath}" FontSize="11" Foreground="#00F0FF" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="📂 저장 폴더 변경..." Style="{StaticResource RetroButtonStyle}"
                                        Command="{Binding ChangeDownloadFolderCommand}" Height="28" Padding="12,4" Margin="0,0,8,0"/>
                                <Button Content="📁 탐색기에서 열기" Style="{StaticResource RetroButtonStyle}"
                                        Command="{Binding OpenStorageFolderCommand}" Height="28" Padding="12,4"/>
                            </StackPanel>

                            <Border Height="1" Background="#1C2738" Margin="0,0,0,16"/>

                            <!-- 2. 오디오 분석 및 변환 임시 캐시 폴더 -->
                            <TextBlock Text="⚡ 오디오 분석 및 변환 임시 캐시 (Temp Cache)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="AI 채보 및 오디오 처리 중 생성되는 임시 파일 경로입니다. 용량 확보를 위해 언제든 비울 수 있습니다."
                                       FontSize="10" Foreground="#7A8E9F" Margin="0,0,0,8"/>

                            <Border Background="#0A0E18" CornerRadius="6" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding CurrentTempPath}" FontSize="11" Foreground="#8FA3B8" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="🧹 임시 캐시 비우기" Style="{StaticResource RetroButtonStyle}"
                                        Command="{Binding ClearTempCacheCommand}" Height="28" Padding="12,4" Margin="0,0,8,0"/>
                                <Button Content="📁 캐시 폴더 열기" Style="{StaticResource RetroButtonStyle}"
                                        Command="{Binding OpenTempFolderCommand}" Height="28" Padding="12,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
