<UserControl x:Class="AuraLe.Views.PlaylistDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <!-- ================= 우측 플레이리스트 사이드 랙 (본체 높이에 100% 자동 도킹) ================= -->
    <Border Width="290" Margin="0,10,10,10" CornerRadius="18" VerticalAlignment="Stretch"
            Background="#13141B" BorderBrush="#2C2C3C" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 상단 드래그 헤더 -->
                <RowDefinition Height="*"/>    <!-- 플레이리스트 목록 (남은 공간 자동 채움) -->
                <RowDefinition Height="Auto"/> <!-- 하단 설정 유틸리티 바 -->
            </Grid.RowDefinitions>

            <!-- 서랍 헤더 / 드래그 바 -->
            <Border Grid.Row="0" Background="#1A1A24" CornerRadius="18,18,0,0" Padding="14,10" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏏ TAPE RACK" FontWeight="Bold" FontSize="12" Foreground="#00F0FF"/>
                        <TextBlock Text=" • PLAYLIST" FontSize="11" Foreground="#888899" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🔄" ToolTip="목록 새로고침" Style="{StaticResource RetroButtonStyle}"
                                Command="{Binding RefreshPlaylistCommand}" Padding="6,2" Margin="0,0,6,0" FontSize="11"/>
                        <Button Content="✕" ToolTip="서랍 닫기" Style="{StaticResource RetroButtonStyle}"
                                Command="{Binding ToggleDrawerCommand}" Padding="6,2" FontSize="11" Foreground="#FF5555"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 서랍 본체: 플레이리스트 목록 -->
            <Border Grid.Row="1" Margin="10,8,10,6" Background="#161720" CornerRadius="10" BorderBrush="#262734" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 트랙 현황 요약 -->
                    <Border Grid.Row="0" Background="#1E1F2C" Padding="10,6" CornerRadius="10,10,0,0">
                        <Grid>
                            <TextBlock Text="저장된 테이프" FontSize="10" Foreground="#8A9AA8" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Playlist.Count, StringFormat='총 {0}곡'}" FontSize="10" Foreground="#FFE600" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- 플레이리스트 ListBox (MaxHeight 제거로 높이에 맞춰 자동 확장) -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Playlist}" SelectedItem="{Binding CurrentTrack}"
                             Background="Transparent" BorderThickness="0" Foreground="#E0E0E0"
                             MouseDoubleClick="Playlist_MouseDoubleClick" Margin="4"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="10" Foreground="#7A7A8C" Margin="6,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="🗑️" FontSize="9" Padding="4,2"
                                            Command="{Binding DataContext.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 서랍 하단: 음원 보관 폴더 열기 (중복된 배경/투명도/위치 조절 설정 제거 완료) -->
            <Border Grid.Row="2" Margin="10,4,10,10" Background="#181924" CornerRadius="10" Padding="8,6" BorderBrush="#262734" BorderThickness="1">
                <Button Content="📁 음원 보관함 열기" Style="{StaticResource RetroButtonStyle}"
                        Command="{Binding OpenStorageFolderCommand}" HorizontalAlignment="Stretch" Padding="8,5" FontSize="10.5"/>
            </Border>
        </Grid>
    </Border>
</UserControl>