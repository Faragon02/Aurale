<UserControl x:Class="AuraLe.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
                <!-- ================= 4.0 홈 대시보드 뷰 (🏠 Home View) ================= -->
                 <Border Height="370" Margin="14,8,14,12" CornerRadius="18" Background="#141822" BorderBrush="#FFE600" BorderThickness="1.5" Padding="14,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#FFE600" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="HOME" FontWeight="Black" FontSize="11" Foreground="#0E0E12"/>
                                    </Border>
                                       <TextBlock Text="AuraLe CASSETTE SYSTEM DASHBOARD" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Border CornerRadius="10" Background="#0C1018" BorderBrush="#203042" BorderThickness="1" Height="160" ClipToBounds="True" Margin="0,0,0,12">
                                    <Grid>
                                        <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.9" Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVis}}">
                                            <Image.RenderTransform>
                                                <TranslateTransform X="{Binding BackgroundImageOffsetX}"/>
                                            </Image.RenderTransform>
                                        </Image>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding HasBackgroundImage, Converter={StaticResource InvBoolToVis}}">
                                            <TextBlock Text="📼" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="AuraLe RETRO WALKMAN" FontWeight="Bold" FontSize="14" Foreground="#00F0FF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="상단 [⏏ 서랍]을 열어 나만의 배경 일러스트를 등록해보세요." FontSize="11" Foreground="#7A8A9A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#18202E" CornerRadius="8" Padding="12,10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="현재 로드된 테이프" FontSize="10" Foreground="#8A9AA8"/>
                                            <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='없음'}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#18202E" CornerRadius="8" Padding="12,10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="보관함 트랙 수" FontSize="10" Foreground="#8A9AA8"/>
                                            <TextBlock Text="{Binding Playlist.Count, StringFormat='총 {0}곡 수록'}" FontWeight="Bold" FontSize="13" Foreground="#FFE600" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="3">
                                    <Button Content="▶ 덱으로 재생" Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding SwitchViewCommand}" CommandParameter="Player" Margin="0,0,3,0" Height="36"/>
                                            Command="{Binding SwitchViewCommand}" CommandParameter="Download" Margin="2,0,2,0" Height="36"/>
                                    <Button Content="🎹 쿼티 연주" Style="{StaticResource RetroButtonStyle}"
                                            Command="{Binding SwitchViewCommand}" CommandParameter="Synth" Margin="2,0,2,0" Height="36"
                                            BorderBrush="#00F0FF" Foreground="#00F0FF"/>
                                    <Button Content="📁 음원 폴더" Style="{StaticResource RetroButtonStyle}"
                                            Command="{Binding OpenStorageFolderCommand}" Margin="3,0,0,0" Height="36"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
</UserControl>

